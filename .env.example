# Server Environment
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:5173"

# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wasl?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wasl?schema=public"

# Authentication (generate at least 32 random characters; never commit the real value)
BETTER_AUTH_SECRET="replace_with_at_least_32_random_characters"

# Transactional Email (optional locally; required for verification/reset emails)
RESEND_API_KEY=""
EMAIL_FROM="WASL <onboarding@resend.dev>"

# AI Provider Configuration (server-only, never VITE_)
# When missing, WASL falls back to deterministic recommendations — live AI is optional locally and tests do not require a real key.
AI_PROVIDER_API_KEY=""
# Optional OpenAI-compatible model (defaults to gpt-4o-mini when not set)
AI_PROVIDER_MODEL="gpt-4o-mini"
