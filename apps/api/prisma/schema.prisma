datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String           @id @default(uuid())
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  role          UserRole         @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  analytics     AnalyticsEvent[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Profile {
  id             String   @id @default(uuid())
  city           String
  university     String
  arrivalStage   String
  turkishLevel   String
  specialization String
  interests      String[]
  goals          String[]
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Community {
  id               String    @id @default(uuid())
  name             String
  description      String
  category         String
  languages        String[]
  universities     String[]
  interests        String[]
  location         String?
  targetAudience   String?
  joinUrl          String?
  newcomerFriendly Boolean   @default(false)
  verified         Boolean   @default(false)
  lastReviewed     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([location])
  @@index([verified])
}

model Resource {
  id           String    @id @default(uuid())
  title        String
  description  String
  category     String
  url          String
  source       String
  lastReviewed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Opportunity {
  id          String    @id @default(uuid())
  title       String
  description String
  category    String
  city        String?
  url         String
  deadline    DateTime?
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([city])
  @@index([verified])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  name       String
  properties Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}
