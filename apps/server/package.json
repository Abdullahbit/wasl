{
  "name": "@wasl/server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@wasl/contracts": "workspace:*",
    "cors": "^2.8.5",
    "better-auth": "^1.3.8",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^7.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "resend": "^6.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@wasl/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.14.0",
    "supertest": "^7.1.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.0"
  }
}
